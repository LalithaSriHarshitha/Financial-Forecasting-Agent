# Copy this file to .env and fill in the values:  copy .env.example .env   (Windows)
#                                                 cp .env.example .env     (macOS/Linux)

# ---- LLM provider: "gemini" (Google API, verified default) or "ollama" (local models) ----
LLM_PROVIDER=gemini

# ---- Ollama (only when LLM_PROVIDER=ollama; https://ollama.com) ----
OLLAMA_BASE_URL=http://localhost:11434
# Chat model with tool calling. 16 GB RAM: qwen3:8b   |   8 GB RAM: qwen3:4b
OLLAMA_MODEL=qwen3:8b
# Optional separate model for the tools' internal calls (leave empty to reuse OLLAMA_MODEL)
OLLAMA_TOOL_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Context window in tokens (larger = more RAM). 16384 fits the forecast prompts.
OLLAMA_NUM_CTX=16384
# Max tokens per reply (stops runaway generations) and per-call timeout in seconds.
OLLAMA_NUM_PREDICT=3072
OLLAMA_TIMEOUT_S=900

# Transcript excerpts retrieved per topic per quarter
RAG_CHUNKS_PER_QUARTER=2

# ---- Google Gemini (default provider; key from https://aistudio.google.com/apikey) ----
GOOGLE_API_KEY=your-gemini-api-key
# Chat model used by the agent and both tools. Run `python -m app.check` to list the models your key can use.
GEMINI_MODEL=gemini-3.6-flash
# Optional: separate model for the tools' internal calls (free-tier quotas are per model,
# so e.g. a flash-lite model here spreads the load). Leave empty to use GEMINI_MODEL.
GEMINI_TOOL_MODEL=
# Embedding model used to index the earnings-call transcripts.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
LLM_TEMPERATURE=0.2
# Rate limits (free tier defaults). Raise them if your key is on a paid tier.
LLM_REQUESTS_PER_MINUTE=8
EMBED_REQUESTS_PER_MINUTE=90

# ---- Market data (bonus MarketDataTool; Yahoo Finance, no key needed) ----
MARKET_DATA_ENABLED=true
MARKET_SYMBOL=TCS.NS

# Maximum time for one forecast request, in seconds
FORECAST_TIMEOUT_S=600

# ---- MySQL 8.0 ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=forecast_user
MYSQL_PASSWORD=YourStrongPass@123
MYSQL_DATABASE=tcs_forecast

# ---- Paths (relative to the project root) ----
DATA_DIR=data
CHROMA_DIR=data/chroma

LOG_LEVEL=INFO
