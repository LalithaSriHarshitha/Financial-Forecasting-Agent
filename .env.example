# Copy this file to .env and fill in the values:  copy .env.example .env   (Windows)
#                                                 cp .env.example .env     (macOS/Linux)

# ---- Google Gemini (https://aistudio.google.com/apikey) ----
GOOGLE_API_KEY=your-gemini-api-key
# Chat model used by the agent and both tools. Run `python -m app.check` to list the models your key can use.
GEMINI_MODEL=gemini-3.6-flash
# Optional: separate model for the tools' internal calls (free-tier quotas are per model,
# so e.g. a flash-lite model here spreads the load). Leave empty to use GEMINI_MODEL.
GEMINI_TOOL_MODEL=
# Embedding model used to index the earnings-call transcripts.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
LLM_TEMPERATURE=0.2
# Rate limits (free tier defaults). Raise them if your key is on a paid tier.
LLM_REQUESTS_PER_MINUTE=8
EMBED_REQUESTS_PER_MINUTE=90

# ---- MySQL 8.0 ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=forecast_user
MYSQL_PASSWORD=YourStrongPass@123
MYSQL_DATABASE=tcs_forecast

# ---- Paths (relative to the project root) ----
DATA_DIR=data
CHROMA_DIR=data/chroma

LOG_LEVEL=INFO
